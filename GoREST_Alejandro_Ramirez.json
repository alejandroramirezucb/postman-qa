    {
      "name": "Users",
      "item": [
        {
          "name": "Crear Usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"email\", \"alejandro_\" + Date.now() + \"@qatest.com\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "",
                  "pm.test(\"El usuario se creo bien\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(json.id).to.not.be.undefined;",
                  "    pm.environment.set(\"userId\", json.id);",
                  "});",
                  "",
                  "pm.test(\"Los datos guardados coinciden con los enviados\", function () {",
                  "    pm.expect(json.name).to.eql(pm.environment.get(\"nombreUsuario\"));",
                  "    pm.expect(json.email).to.eql(pm.environment.get(\"email\"));",
                  "    pm.expect(json.status).to.eql(\"active\");",
                  "});",
                  "",
                  "pm.test(\"El tiempo de respuesta es menor a 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{nombreUsuario}}\",\n    \"gender\": \"male\",\n    \"email\": \"{{email}}\",\n    \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Obtener Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
