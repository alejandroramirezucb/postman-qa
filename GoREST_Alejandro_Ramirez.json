                  "pm.test(\"Los datos del usuario son los esperados\", function () {",
                  "    pm.expect(json.name).to.eql(pm.environment.get(\"nombreUsuario\"));",
                  "    pm.expect(json.email).to.eql(pm.environment.get(\"email\"));",
                  "});"
