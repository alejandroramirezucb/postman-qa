        {
          "name": "Listar Usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "",
                  "pm.test(\"La lista de usuarios se obtuvo correctamente\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "    pm.expect(json.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Cada usuario tiene los campos requeridos\", function () {",
                  "    pm.expect(json[0]).to.have.property(\"id\");",
                  "    pm.expect(json[0]).to.have.property(\"name\");",
                  "    pm.expect(json[0]).to.have.property(\"email\");",
                  "    pm.expect(json[0]).to.have.property(\"status\");",
                  "});"
                ]
              }
            }
